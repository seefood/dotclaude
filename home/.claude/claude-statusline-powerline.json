{
  "$schema": "https://raw.githubusercontent.com/spences10/claude-statusline-powerline/main/statusline.schema.json",
  "color_theme": "dark",
  "font_profile": "nerd-font",
  "segment_config": {
    "segments": [
      {
        "style": {
          "icons": {
            "ai": "🤖"
          }
        },
        "type": "model"
      },
      {
        "style": {
          "icons": {
            "folder": "🗂️"
          }
        },
        "type": "directory"
      },
      {
        "style": {
          "icons": {
            "branch": "🌿",
            "clean": "✅",
            "dirty": "⚠️"
          },
          "truncation_length": 20
        },
        "type": "git"
      },
      {
        "style": {
          "icons": {
            "cost": "💲"
          }
        },
        "type": "session"
      }
    ]
  }
}
