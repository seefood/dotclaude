{
  "alwaysThinkingEnabled": true,
  "cleanupPeriodDays": 365,
  "effortLevel": "high",
  "enableAllProjectMcpServers": false,
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "debugging-with-the-scientific-method@ira-claude-plugins": false,
    "hookify@claude-plugins-official": false,
    "json-to-toon@ira-claude-plugins": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "settings-curator@ira-claude-plugins": true,
    "superpowers@claude-plugins-official": true,
    "test-before-install@ira-claude-plugins": true
  },
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "0",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "DISABLE_AUTOUPDATER": "0",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1",
    "VISUAL": "~/.claude/skills/enhance/scripts/enhance"
  },
  "extraKnownMarketplaces": {
    "ira-claude-plugins": {
      "source": {
        "repo": "seefood/ira-claude-plugins",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/play-sound.sh notification",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "PATH=\"/opt/homebrew/bin:/usr/local/bin${PATH:+:$PATH}\" node ${HOME}'/.claude/statusbar/update.js' notify",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "${HOME}/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "PATH=\"/opt/homebrew/bin:/usr/local/bin${PATH:+:$PATH}\" node ${HOME}'/.claude/statusbar/update.js' permreq",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "[ -n \"$WEZTERM_PANE\" ] && curl -sf --unix-socket \"$HOME/.local/state/blinkenkeys/api.sock\" -X PUT \"http://localhost/devices/uid-440d6644c3b0438c/keys/0,$(( WEZTERM_PANE % 4 ))\" -H 'Content-Type: application/json' -d '{\"state\":\"claude/waiting\"}' 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/format-file.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|MultiEdit"
      },
      {
        "hooks": [
          {
            "command": "${HOME}/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "PATH=\"/opt/homebrew/bin:/usr/local/bin${PATH:+:$PATH}\" node ${HOME}'/.claude/statusbar/update.js' post",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/scripts/validate-bash.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "PATH=\"/opt/homebrew/bin:/usr/local/bin${PATH:+:$PATH}\" node ~/'.claude/statusbar/update.js' pre",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "PATH=\"/opt/homebrew/bin:/usr/local/bin${PATH:+:$PATH}\" node ~/'.claude/statusbar/lifecycle.js' end",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -n \"$WEZTERM_PANE\" ] && curl -sf --unix-socket \"$HOME/.local/state/blinkenkeys/api.sock\" -X PUT \"http://localhost/devices/uid-440d6644c3b0438c/keys/0,$(( WEZTERM_PANE % 4 ))\" -H 'Content-Type: application/json' -d '{\"color\":\"#000000\"}' 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "PATH=\"/opt/homebrew/bin:/usr/local/bin${PATH:+:$PATH}\" node ~/'.claude/statusbar/lifecycle.js' start",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -n \"$WEZTERM_PANE\" ] && curl -sf --unix-socket \"$HOME/.local/state/blinkenkeys/api.sock\" -X PUT \"http://localhost/devices/uid-440d6644c3b0438c/keys/0,$(( WEZTERM_PANE % 4 ))\" -H 'Content-Type: application/json' -d '{\"state\":\"claude/idle\"}' 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/play-sound.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "claudekit-hooks run self-review",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "PATH=\"/opt/homebrew/bin:/usr/local/bin${PATH:+:$PATH}\" node ~/'.claude/statusbar/update.js' stop",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -n \"$WEZTERM_PANE\" ] && curl -sf --unix-socket \"$HOME/.local/state/blinkenkeys/api.sock\" -X PUT \"http://localhost/devices/uid-440d6644c3b0438c/keys/0,$(( WEZTERM_PANE % 4 ))\" -H 'Content-Type: application/json' -d '{\"state\":\"claude/idle\"}' 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "claudekit-hooks run codebase-map",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "~/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "PATH=\"/opt/homebrew/bin:/usr/local/bin${PATH:+:$PATH}\" node ~/'.claude/statusbar/update.js' prompt",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -n \"$WEZTERM_PANE\" ] && curl -sf --unix-socket \"$HOME/.local/state/blinkenkeys/api.sock\" -X PUT \"http://localhost/devices/uid-440d6644c3b0438c/keys/0,$(( WEZTERM_PANE % 4 ))\" -H 'Content-Type: application/json' -d '{\"state\":\"claude/working\"}' 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "sonnet",
  "modelSettings": {
    "claude-opus-5": {
    },
    "claude-opus-5-5": {
    },
    "claude-sonnet-5": {
    }
  },
  "permissions": {
    "allow": [
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(npm run *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(brew install *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(curl *|bash*)",
      "Bash(wget *|bash*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.npm/**)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Application Support/**/metamask*/**)",
      "Read(~/Library/Application Support/**/electrum*/**)",
      "Read(~/Library/Application Support/**/exodus*/**)",
      "Read(~/Library/Application Support/**/phantom*/**)",
      "Read(~/Library/Application Support/**/solflare*/**)"
    ]
  },
  "skillOverrides": {
    "agents-md:cli": "off",
    "agents-md:init": "off",
    "agents-md:migration": "off",
    "all-tools": "name-only",
    "brainstorming": "off",
    "challenger": "on",
    "checkpoint:create": "off",
    "checkpoint:list": "off",
    "checkpoint:restore": "off",
    "cleanproject": "off",
    "code-review": "name-only",
    "commit": "name-only",
    "config:bash-timeout": "name-only",
    "containerize-application": "name-only",
    "contributing": "name-only",
    "create-architecture-documentation": "name-only",
    "create-command": "off",
    "create-onboarding-guide": "off",
    "create-prd": "off",
    "create-subagent": "off",
    "create-todos": "off",
    "dev:cleanup": "off",
    "docs": "off",
    "explain-code": "name-only",
    "explain-like-senior": "name-only",
    "find-todos": "off",
    "fix-imports": "user-invocable-only",
    "fix-todos": "off",
    "format": "off",
    "generate-tests": "off",
    "gh:repo-init": "off",
    "git-status": "off",
    "git:checkout": "off",
    "git:commit": "off",
    "git:ignore-init": "off",
    "git:push": "off",
    "git:status": "off",
    "implement": "off",
    "make-it-pretty": "off",
    "nfr-analyst": "off",
    "owasp-security": "off",
    "predict-issues": "name-only",
    "rate-me": "name-only",
    "refactor": "off",
    "remove-comments": "off",
    "research": "off",
    "review": "off",
    "scaffold": "off",
    "security-scan": "name-only",
    "session-end": "off",
    "session-start": "off",
    "spec:create": "off",
    "spec:decompose": "off",
    "spec:execute": "off",
    "spec:validate": "off",
    "test": "off",
    "test-coverage": "off",
    "todo": "name-only",
    "todos-to-issues": "off",
    "ultra-think": "off",
    "understand": "off",
    "undo": "off",
    "validate-and-fix": "off"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "~/.claude/super-status/statusline.sh",
    "refreshInterval": 10,
    "type": "command"
  },
  "terminalProgressBarEnabled": false,
  "tui": "default",
  "verbose": true,
  "voiceEnabled": true
}
